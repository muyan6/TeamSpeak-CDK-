# Web 监听端口
SERVER_HOST=0.0.0.0
SERVER_PORT=12345

# 管理后台密码（访问 /admin 时使用）
ADMIN_PASSWORD=admin123456

# 数据与 compose 根目录（Linux 默认 /data/teamspeak）
TS_DATA_DIR=/data/teamspeak

# TS 服务器对外展示的公网 IP 或域名（选填，留空则自动获取访问 Host）
PUBLIC_SERVER_IP=

# 基础端口避让（官方默认被占用的端口）
BASE_VOICE_PORT=9987
BASE_FILE_PORT=30033
BASE_QUERY_PORT=10011
BASE_TSDNS_PORT=41144
