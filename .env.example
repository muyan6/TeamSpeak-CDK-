# ===== Web 服务监听 =====
SERVER_HOST=0.0.0.0
SERVER_PORT=12345

# ===== 管理员口令 =====
# 建议配置！未配置时系统首次启动会自动生成随机口令并持久化到数据库且打印到启动日志（重启保持不变）。
# 首次登录后建议在后台【修改密码】。
ADMIN_PASSWORD=please-change-me

# ===== 数据与 compose 根目录（Linux 默认 /data/teamspeak）=====
TS_DATA_DIR=/data/teamspeak

# ===== 对外展示的 TS 公网 IP / 域名 =====
# 强烈建议显式配置。留空时会退化为使用请求的 Host 头，
# 反代配置不当时可能向用户下发错误连接地址。
PUBLIC_SERVER_IP=

# ===== 反向代理信任开关 =====
# 默认 0（不信任）。只有当本服务部署在自建可信反向代理（Nginx/Traefik 等）之后，
# 且代理已正确覆写 X-Forwarded-For / X-Forwarded-Host 时，才可设为 1。
# 开启后这些请求头将用于判定客户端真实 IP（体验卡防刷）与对外地址。
TRUST_PROXY_HEADERS=0

# ===== 基础端口分段配置 =====
# ts1 -> voice 60001 / file 20001 / query 30001 / tsdns 40001
BASE_VOICE_PORT=60000
BASE_FILE_PORT=20000
BASE_QUERY_PORT=30000
BASE_TSDNS_PORT=40000

# 自动防火墙预放行的端口段宽度（会随实际最大已分配实例号自动扩展）
FIREWALL_PORT_SPAN=200

# ===== 音乐机器人后台服务中心配置 =====
# 不提供内置默认账号密码，必须在此填写或稍后在管理后台配置。
BOT_PANEL_URL=
BOT_PANEL_USER=
BOT_PANEL_PASS=
BOT_TUTORIAL_URL=
